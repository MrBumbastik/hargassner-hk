{
  "config": {
    "step": {
      "user": {
        "title": "Hargassner wood chip boiler",
        "description": "Connect to the local data stream of the Touch-Tronic (LAN, port 23).\n\nThe **DAQ template** is optional: leave it empty and the integration detects your boiler from the templates it ships with. Only if your boiler is not recognised, export the template: **Settings → Setup → File manager → DAQ**, choose the newest file, **Export**, and paste the `DAQPRJ` block from the start of the file.",
        "data": {
          "name": "Name",
          "host": "IP address of the boiler",
          "port": "Port",
          "daq_xml": "DAQ template (optional)"
        }
      },
      "cloud": {
        "title": "Hargassner cloud (optional)",
        "description": "The local stream is read-only. To also control setpoints and modes, enter your Hargassner app login. Leave both fields empty to continue without the cloud.",
        "data": {
          "email": "Email",
          "password": "Password"
        }
      },
      "installation": {
        "title": "Choose installation",
        "data": {
          "installation_id": "Installation"
        }
      },
      "reauth_confirm": {
        "title": "Cloud login expired",
        "description": "The Hargassner cloud rejected the stored credentials.",
        "data": {
          "email": "Email",
          "password": "Password"
        }
      },
      "reconfigure_local": {
        "title": "Reconfigure boiler",
        "description": "Change the address or import a new DAQ template, e.g. after a firmware update.",
        "data": {
          "host": "IP address of the boiler",
          "port": "Port",
          "daq_xml": "DAQ template (optional)"
        }
      },
      "reconfigure": {
        "title": "Reconfigure",
        "description": "What do you want to change?",
        "menu_options": {
          "reconfigure_local": "Boiler connection / DAQ template",
          "reconfigure_cloud": "Hargassner cloud login"
        }
      },
      "reconfigure_cloud": {
        "title": "Hargassner cloud",
        "description": "Enter your Hargassner app login to add or change the cloud connection. Leave both fields empty to remove it.",
        "data": {
          "email": "Email",
          "password": "Password"
        }
      }
    },
    "error": {
      "invalid_daq": "The DAQ template could not be read: {error_detail}",
      "cannot_connect": "No connection to the boiler. Check IP address, port and that the boiler is on the LAN.",
      "template_mismatch": "The boiler sends {received} values per line, the template describes {expected}. The template does not match this firmware.",
      "invalid_auth": "Cloud login failed: wrong email or password.",
      "cloud_cannot_connect": "The Hargassner cloud is not reachable.",
      "no_installations": "No installation found in this cloud account.",
      "credentials_required": "Enter both email and password, or leave both empty to continue without the cloud.",
      "template_required": "Your boiler (sends {received} values per line) is not among the templates shipped with the integration. Please paste the DAQ template of your boiler (see the description above)."
    },
    "abort": {
      "already_configured": "This boiler is already set up.",
      "reconfigure_successful": "Configuration updated.",
      "reauth_successful": "Login updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Settings",
        "description": "Heat and fuel are estimated from the burner output: heat = output × nominal power, fuel = heat ÷ (calorific value × efficiency). Calibrate the calorific value with real deliveries.",
